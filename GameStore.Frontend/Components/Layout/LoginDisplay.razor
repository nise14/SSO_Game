<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center">
            <span class="link-light text-decoration-none me-2">
                @context.User.Identity?.Name
            </span>
            <form method="post" action="authentication/logout" class="d-inline">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
            </form>
        </div>        
    </Authorized>
    <NotAuthorized>
        <a href="authentication/login" class="btn btn-warning">Login</a>
    </NotAuthorized>
</AuthorizeView>