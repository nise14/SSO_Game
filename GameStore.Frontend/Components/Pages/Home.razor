@page "/"
@inject GamesClient Client
@attribute [StreamRendering]

<PageTitle>Game Catalog</PageTitle>

<div class="mt-2">
    <AuthorizeView>
        <a class="btn btn-primary" role="button" href="/editgame">New Game</a>
    </AuthorizeView>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-2" role="alert">
        @errorMessage
    </div>
}

@if (games is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped table-bordered table-hover mt-3">
        <thead class="table-dark">
            <th>Id</th>
            <th>Name</th>
            <th>Genre</th>
            <th class="text-end">Price</th>
            <th>Release Date</th>
            <AuthorizeView>
                <th></th>
            </AuthorizeView>
        </thead>
        <tbody>
            @foreach (var game in games)
            {
                <tr>
                    <td>@game.Id</td>
                    <td>@game.Name</td>
                    <td>@game.Genre</td>
                    <td class="text-end">@game.Price.ToString("C2")</td>
                    <td>@game.ReleaseDate</td>
                    <AuthorizeView>
                        <td>
                            <div class="d-flex">
                                <a class="btn btn-primary me-2" role="button" href="@GameUrl(game.Id)">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="@GetDeleteModalId(game)">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <DeleteGame Game="@game" />
                        </td>
                    </AuthorizeView>
                </tr>
            }
        </tbody>
    </table>
}

<form @formname="delete-game-form" @onsubmit="@ConfirmDeleteAsync"></form>

@code {
    private GameSummary[]? games;

    [SupplyParameterFromForm]
    private int? GameIdToDelete { get; set; }

    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadGamesAsync();
    }

    private async Task LoadGamesAsync()
    {
        try
        {
            games = await Client.GetGamesAsync();
            errorMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading games: {ex.Message}";
            games = Array.Empty<GameSummary>();
        }
    }

    private static string GameUrl(int id) => $"/editgame/{id}";

    private string GetDeleteModalId(GameSummary game)
    {
        return $"#{DeleteGame.GetModalId(game)}";
    }

    private async Task ConfirmDeleteAsync()
    {
        try
        {
            await Client.DeleteGameAsync(GameIdToDelete!.Value);
            await LoadGamesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting game: {ex.Message}";
            StateHasChanged();
        }
    }
}